<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F3EFE9">

    <VerticalStackLayout Padding="25"
                         Spacing="20"
                         VerticalOptions="Center"
                         HorizontalOptions="Center">

        <Label Text="Sobre"
               FontFamily="Felipa"
               FontSize="40"
               TextColor="#633D46"
               HorizontalOptions="Center"/>

        <Frame Padding="25"
               CornerRadius="15"
               BackgroundColor="White"
               BorderColor="#E8DDD9"
               HasShadow="True">

            <VerticalStackLayout Spacing="15">

                <Label Text="MAUI APP HOTEL"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#633D46"
                       HorizontalOptions="Center"/>

                <BoxView HeightRequest="1"
                         Color="#E8DDD9"/>

                <Label Text="Desenvolvedora"
                       FontSize="13"
                       TextColor="#8B5360"
                       HorizontalOptions="Center"/>

                <Label Text="Gabriela Neves"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="#51494A"
                       HorizontalOptions="Center"/>

                <Label Text="ETEC - 2026"
                       FontSize="14"
                       TextColor="#82777A"
                       HorizontalOptions="Center"/>

            </VerticalStackLayout>

        </Frame>

    </VerticalStackLayout>

</ContentPage>
